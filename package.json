{
  "name": "subspace_mail",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "next build && electron-builder",
    "package": "electron-builder"
  },
  "dependencies": {
    "@azure/msal-node": "^3.8.4",
    "@google-cloud/local-auth": "^3.0.1",
    "@left4code/svg-renderer": "^1.0.4",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "date-fns": "^4.1.0",
    "electron-store": "^9.0.0",
    "googleapis": "^128.0.0",
    "imap": "^0.8.17",
    "isomorphic-fetch": "^3.0.0",
    "mailparser": "^3.9.1",
    "next": "16.1.1",
    "nodemailer": "7.0.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "dev.zytronium.subspacemail",
    "productName": "Subspace Mail",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
